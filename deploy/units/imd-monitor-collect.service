[Unit]
Description=IMD monitor - fast per-seat state collector (no model calls)

[Service]
Type=oneshot
# Root-owned collector, run under THIS seat's identity by its own user manager.
# -I: isolated mode (no user site-packages, no PYTHON* variables), so a file a job writes under the
# seat's home cannot run code here, outside the job sandbox. Tools are called by absolute path.
Environment=PATH=/usr/bin:/bin
UnsetEnvironment=PYTHONPATH PYTHONHOME PYTHONSTARTUP LD_PRELOAD NODE_OPTIONS
ExecStart=/usr/bin/python3 -I /opt/imd-monitor/collectors/seat-collector.py --out /var/lib/imd-monitor/incoming
Nice=10
TimeoutStartSec=45
